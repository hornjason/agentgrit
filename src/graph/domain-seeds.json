{
  "version": 1,
  "description": "Handcrafted domain patterns. pattern = broad (Set-based consumers). cascadePattern = specific (first-match-wins cascade). Used as fallback when a domain has fewer than 3 classified rules in the graph.",
  "patterns": [
    {
      "domain": "infra",
      "terms": ["docker", "podman", "container", "mac mini", "ghcr", "deploy", "rebuild", "makefile", "daemon", "image", "port", "hero"],
      "pattern": "docker|podman|container|mac.?mini|ghcr|\\bdeploy\\b|\\brebuild\\b|makefile|daemon|\\bimage\\b.*build|\\bport\\b.*\\d|\\bhero\\b",
      "cascadePattern": "docker.*build|podman.*run|mac.?mini|ghcr\\.io|rebuild.*image|makefile.*target|hero.*install|\\binfra\\b|container.*image",
      "negativePattern": "before assert|check before|read before|verify state",
      "priority": 1
    },
    {
      "domain": "scraper",
      "terms": ["scraper", "saleshub", "enrich", "product", "extraction", "vnc", "checklist", "signal refresh"],
      "pattern": "scraper|saleshub|\\benrich\\b|product.*scrap|extraction|\\bvnc\\b|checklist|signal.*refresh",
      "cascadePattern": "scraper.*run|saleshub.*page|enrich.*product|product.*scrap|extraction.*gate|vnc.*session",
      "priority": 2
    },
    {
      "domain": "process",
      "terms": ["dev loop", "worktree", "commit gate", "ship workflow", "scope check", "quality loop", "pipeline sequence", "audit gate"],
      "pattern": "dev.?loop|worktree|commit.*gate|ship.*workflow|scope.*check|quality.*loop|pipeline.*sequence|audit.*gate",
      "cascadePattern": "dev.?loop.*mandatory|worktree.*isolation|commit.*gate.*pass|ship.*workflow.*scope|scope.*check.*diff|quality.*loop.*cycle",
      "priority": 3
    },
    {
      "domain": "deployment",
      "terms": ["makefile", "make rebuild", "make test", "test container", "deploy"],
      "pattern": "makefile|make rebuild|make test|test container|deploy",
      "cascadePattern": "makefile|make rebuild|make test|test container|deploy sequence",
      "negativePattern": "before assert|check before|read before|verify state",
      "priority": 4
    },
    {
      "domain": "testing",
      "terms": ["test first", "tdd", "unit test", "e2e test", "regression", "test gate", "fresh container test", "cleanup test"],
      "pattern": "test.*first|\\btdd\\b|unit.*test|e2e.*test|regression|test.*gate|fresh.*container.*test|cleanup.*test",
      "cascadePattern": "test.*first.*deploy|tdd.*cycle|unit.*test.*gate|e2e.*test.*run|regression.*suite|test.*gate.*pass",
      "priority": 5
    },
    {
      "domain": "ui",
      "terms": ["quinn", "playwright", "visual test", "screenshot", "ui review", "ux", "component render", "browser automation"],
      "pattern": "\\bquinn\\b|playwright|visual.*test|screenshot|ui.*review|\\bux\\b|component.*render|browser.*automat",
      "cascadePattern": "\\bquinn\\b|playwright.*project|visual.*test|screenshot.*valid|ui.*review.*post|browser.*automat.*wait",
      "priority": 6
    },
    {
      "domain": "browser",
      "terms": ["iframe", "page.fill", "page.route", "selector", "sso", "login flow", "browser context"],
      "pattern": "\\biframe\\b|page\\.fill|page\\.route|sso|login.*flow|browser.*context",
      "cascadePattern": "\\biframe\\b|page\\.fill|page\\.route|selector.*fail|sso.*redirect|login.*flow|browser.*context",
      "priority": 7
    },
    {
      "domain": "security",
      "terms": ["security scan", "security gate", "security review", "vulnerability", "destructive", "force push", "auth", "credential", "token secret", "session permission", "access control", "encrypt", "secret key"],
      "pattern": "security scan|security.*gate|security.*review|vulnerability|destructive|force push|\\bauth\\b|credential|token.*secret|session.*permission|access.control|encrypt|secret.*key",
      "priority": 8
    },
    {
      "domain": "delegation",
      "terms": ["spawn agent", "agent spawn", "worktree", "pre-brief", "handoff", "delegate", "marcus", "brief template"],
      "pattern": "spawn.*agent|agent.*spawn|worktree|pre-brief|handoff|delegate|marcus|brief.*template",
      "cascadePattern": "spawn.*agent|agent.*spawn|worktree isolation|pre-brief|handoff|delegate.*code",
      "priority": 9
    },
    {
      "domain": "escalation",
      "terms": ["escalat", "bring in specialist", "wrong approach", "1-2 attempt", "after fail", "stuck"],
      "pattern": "escalat|bring in.*specialist|wrong approach|stuck",
      "cascadePattern": "escalat|bring in.*specialist|wrong approach|1-2 attempt|after.*fail|stuck.*diagnos",
      "priority": 10
    },
    {
      "domain": "algorithm",
      "terms": ["prd", "isc", "algorithm phase", "effort level", "criteria count", "scoring", "rating signal", "correlation"],
      "pattern": "\\bprd\\b|\\bisc\\b|algorithm.*phase|effort level|scoring|rating.*signal|correlation",
      "cascadePattern": "\\bprd\\b|\\bisc\\b|algorithm.*phase|effort level|criteria.*count|scoring.*signal|correlation.*track",
      "priority": 11
    },
    {
      "domain": "memory",
      "terms": ["feedback_.md", "memory.md", "ratings.jsonl", "learning capture", "failure capture", "backlog log"],
      "pattern": "feedback_.*\\.md|memory\\.md|ratings\\.jsonl|learning capture|backlog.*log",
      "cascadePattern": "feedback_.*\\.md|memory\\.md|ratings\\.jsonl|learning capture|failure capture|backlog.*log.*immediate",
      "priority": 12
    },
    {
      "domain": "scope",
      "terms": ["minimal scope", "only asked", "don't add", "unrequested", "stay focused", "match question"],
      "pattern": "minimal.*scope|only.*asked|unrequested|stay.*focused|match.*question",
      "cascadePattern": "minimal.*scope|only.*asked|don.t add|unrequested|no.*cleanup|stay.*focused|match.*question.*scope",
      "priority": 13
    },
    {
      "domain": "delivery",
      "terms": ["false complet", "partial deliver", "incomplete", "not done", "self audit", "before claiming done", "ship", "acceptance criter", "template ac", "github issue"],
      "pattern": "false.*complet|partial.*deliver|incomplete|not.*done|self.audit|\\bship\\b|acceptance.*criter|template.*ac|github.*issue",
      "cascadePattern": "false.*complet|partial.*deliver|incomplete.*deliver|not.*done|self.audit|before.*claiming.*done",
      "priority": 14
    },
    {
      "domain": "data",
      "terms": ["actual data", "live data", "measure before", "read before plan", "real numbers", "pipeline", "promote", "evict", "lifecycle"],
      "pattern": "actual.*data|live.*data|measure.*before|read.*before.*plan|pipeline|\\bpromote\\b|\\bevict\\b|lifecycle",
      "cascadePattern": "actual.*data|live.*data|measure.*before|read.*before.*plan|real.*numbers|pipeline.*health|promote.*rule|evict.*stale|lifecycle.*manage",
      "priority": 15
    },
    {
      "domain": "architecture",
      "terms": ["refactor", "abstract interface", "module boundary", "coupling", "cohesion", "deep module", "migration architecture", "architecture decision", "interface design"],
      "pattern": "\\brefactor\\b|abstract.*interface|module.boundary|coupling|cohesion|deep.module|migration.*architecture|\\barchitecture\\b.*decision|interface.*design",
      "priority": 16
    }
  ]
}
